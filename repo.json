    "splash_screen": {
      "engine": "vector",
      "animation_style": "twin_slash",
      "show_sign_feather": false,
      "duration_seconds": 3,
      "custom_code": "<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#030409\">\n  <title>XSign | شاشة الإقلاع</title>\n\n  <!-- للدمج، انقل هذا الـ style وعنصر #xsign-splash إلى صفحة واجهتك. -->\n  <style>\n    #xsign-splash {\n      --xsign-duration: 3500ms;\n      --xsign-blue: #003173;\n\n      position: fixed;\n      top: 0;\n      right: 0;\n      bottom: 0;\n      left: 0;\n      z-index: 9999;\n      isolation: isolate;\n      box-sizing: border-box;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      padding: 20px;\n      padding: max(20px, env(safe-area-inset-top))\n               max(20px, env(safe-area-inset-right))\n               max(20px, env(safe-area-inset-bottom))\n               max(20px, env(safe-area-inset-left));\n      background: radial-gradient(ellipse at 50% 43%, #081325, #030409 68%);\n      color: #f5f8ff;\n      font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n      opacity: 0;\n      visibility: hidden;\n      animation: xsign-dismiss var(--xsign-duration) linear both;\n    }\n\n    #xsign-splash::before {\n      content: \"\";\n      position: absolute;\n      top: 43%;\n      left: 50%;\n      width: min(530px, 106vw);\n      height: min(390px, 76vh);\n      background: radial-gradient(ellipse closest-side, var(--xsign-blue), #0a2046 46%, transparent);\n      animation: xsign-halo calc(var(--xsign-duration) * .32) ease-out both;\n    }\n\n    .xsign-splash__identity {\n      position: relative;\n      display: grid;\n      justify-items: center;\n      transform: translateY(-2vh);\n    }\n\n    .xsign-splash__mark {\n      display: block;\n      width: clamp(204px, 59vw, 272px);\n      height: auto;\n      margin-bottom: -3px;\n    }\n\n    .xsign-splash__orbit {\n      transform-origin: 128px 120px;\n      animation: xsign-orbit calc(var(--xsign-duration) * .36) ease-out both;\n    }\n\n    .xsign-splash__ribbon {\n      animation: xsign-ribbon-in calc(var(--xsign-duration) * .26)\n                 cubic-bezier(.16, 1, .3, 1) var(--xsign-ribbon-delay) both;\n    }\n\n    .xsign-splash__ribbon--up {\n      --xsign-offset-x: -38px;\n      --xsign-offset-y: 42px;\n      --xsign-ribbon-delay: calc(var(--xsign-duration) * .02);\n    }\n\n    .xsign-splash__ribbon--down {\n      --xsign-offset-x: 36px;\n      --xsign-offset-y: -37px;\n      --xsign-ribbon-delay: calc(var(--xsign-duration) * .065);\n    }\n\n    .xsign-splash__reflection {\n      animation: xsign-reflect calc(var(--xsign-duration) * .23)\n                 cubic-bezier(.36, 0, .4, 1) calc(var(--xsign-duration) * .29) both;\n    }\n\n    .xsign-splash__wordmark {\n      display: grid;\n      justify-items: center;\n      gap: 14px;\n      animation: xsign-wordmark-in calc(var(--xsign-duration) * .22)\n                 cubic-bezier(.16, 1, .3, 1) calc(var(--xsign-duration) * .20) both;\n    }\n\n    .xsign-splash__name {\n      padding-inline-end: .075em;\n      color: #f5f8ff;\n      font-size: clamp(47px, 13vw, 64px);\n      font-weight: 720;\n      letter-spacing: -.075em;\n      line-height: 1;\n    }\n\n    .xsign-splash__edition {\n      display: flex;\n      align-items: center;\n      gap: 13px;\n      color: #b4c5e3;\n      font-size: 10px;\n      font-weight: 650;\n      letter-spacing: .32em;\n      line-height: 1;\n    }\n\n    .xsign-splash__edition::before,\n    .xsign-splash__edition::after {\n      content: \"\";\n      width: 16px;\n      height: 1px;\n      background: #39639f;\n    }\n\n    @keyframes xsign-halo {\n      from { opacity: 0; transform: translate(-50%, -50%) scale(.86); }\n      to   { opacity: .88; transform: translate(-50%, -50%) scale(1); }\n    }\n\n    @keyframes xsign-orbit {\n      from { opacity: 0; transform: scale(.93); }\n      to   { opacity: 1; transform: scale(1); }\n    }\n\n    @keyframes xsign-ribbon-in {\n      from { opacity: 0; transform: translate(var(--xsign-offset-x), var(--xsign-offset-y)); }\n      to   { opacity: 1; transform: translate(0, 0); }\n    }\n\n    @keyframes xsign-reflect {\n      from { transform: translateX(-82px) skewX(-22deg); }\n      to   { transform: translateX(312px) skewX(-22deg); }\n    }\n\n    @keyframes xsign-wordmark-in {\n      from { opacity: 0; transform: translateY(10px); }\n      to   { opacity: 1; transform: translateY(0); }\n    }\n\n    @keyframes xsign-dismiss {\n      0%, 82% { opacity: 1; visibility: visible; }\n      100%    { opacity: 0; visibility: hidden; }\n    }\n\n    /* أظهر الواجهة فورًا عند الوصول إليها بلوحة المفاتيح. */\n    body:focus-within #xsign-splash {\n      opacity: 0 !important;\n      visibility: hidden !important;\n    }\n\n    @media (max-height: 420px) {\n      .xsign-splash__identity { transform: none; }\n      .xsign-splash__mark { width: min(44vh, 188px); }\n      .xsign-splash__name { font-size: 40px; }\n      .xsign-splash__wordmark { gap: 10px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      #xsign-splash { display: none; animation: none; }\n    }\n  </style>\n\n  <!-- تنسيق صفحة المعاينة فقط. -->\n  <style>\n    body { margin: 0; background: #030409; }\n\n    .xsign-demo {\n      box-sizing: border-box;\n      display: grid;\n      min-height: 100vh;\n      place-items: center;\n      padding: 24px;\n      background: radial-gradient(ellipse at 50% 0%, #0b1830, #030409 68%);\n      color: #f5f8ff;\n      text-align: center;\n      font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n    }\n\n    .xsign-demo__card {\n      width: min(100%, 360px);\n      box-sizing: border-box;\n      padding: 36px 20px;\n      border: 1px solid #1c2a45;\n      border-radius: 24px;\n      background: #090e19;\n    }\n\n    .xsign-demo h1 { margin: 0 0 10px; font-size: 24px; }\n    .xsign-demo p { margin: 0 0 24px; color: #aebed8; line-height: 1.6; }\n\n    .xsign-demo a {\n      display: inline-grid;\n      min-height: 44px;\n      place-items: center;\n      padding: 0 20px;\n      border: 1px solid #3e6fc0;\n      border-radius: 24px;\n      background: #123464;\n      color: #f5f8ff;\n      font-weight: 650;\n      text-decoration: none;\n    }\n\n    .xsign-demo a:focus-visible { outline: 2px solid #9cbfff; outline-offset: 4px; }\n  </style>\n</head>\n<body>\n  <!-- استبدل هذا القسم بواجهة تطبيقك. -->\n  <main class=\"xsign-demo\">\n    <div class=\"xsign-demo__card\">\n      <h1>اكتمل عرض الإقلاع</h1>\n      <p>هنا تظهر واجهة التطبيق بعد تلاشي الشعار.</p>\n      <a href=\"?replay\">إعادة العرض</a>\n    </div>\n  </main>\n\n  <div id=\"xsign-splash\" dir=\"ltr\" aria-hidden=\"true\">\n    <div class=\"xsign-splash__identity\">\n      <svg class=\"xsign-splash__mark\" viewBox=\"0 0 256 240\" width=\"256\" height=\"240\" focusable=\"false\">\n        <defs>\n          <path id=\"xsign-plate-up\" d=\"M162 54H196L94 186H60Z\"/>\n          <path id=\"xsign-plate-down\" d=\"M60 54H94L196 186H162Z\"/>\n          <linearGradient id=\"xsign-ice\" x1=\"65\" y1=\"44\" x2=\"191\" y2=\"190\" gradientUnits=\"userSpaceOnUse\">\n            <stop offset=\"0\" stop-color=\"#ffffff\"/>\n            <stop offset=\".48\" stop-color=\"#f2f6ff\"/>\n            <stop offset=\"1\" stop-color=\"#8fa9d1\"/>\n          </linearGradient>\n          <linearGradient id=\"xsign-steel\" x1=\"79\" y1=\"186\" x2=\"185\" y2=\"54\" gradientUnits=\"userSpaceOnUse\">\n            <stop offset=\"0\" stop-color=\"#4572c4\"/>\n            <stop offset=\".53\" stop-color=\"#93b7f1\"/>\n            <stop offset=\"1\" stop-color=\"#e7f1ff\"/>\n          </linearGradient>\n          <linearGradient id=\"xsign-glint\">\n            <stop offset=\"0\" stop-color=\"#ffffff\" stop-opacity=\"0\"/>\n            <stop offset=\".52\" stop-color=\"#ffffff\" stop-opacity=\".52\"/>\n            <stop offset=\"1\" stop-color=\"#ffffff\" stop-opacity=\"0\"/>\n          </linearGradient>\n          <clipPath id=\"xsign-plate-clip\">\n            <use href=\"#xsign-plate-up\"/>\n            <use href=\"#xsign-plate-down\"/>\n          </clipPath>\n          <filter id=\"xsign-plate-shadow\" x=\"-24%\" y=\"-24%\" width=\"148%\" height=\"148%\" color-interpolation-filters=\"sRGB\">\n            <feDropShadow dx=\"0\" dy=\"3\" stdDeviation=\"5\" flood-color=\"#030714\" flood-opacity=\".7\"/>\n          </filter>\n        </defs>\n\n        <g class=\"xsign-splash__orbit\" fill=\"none\">\n          <circle cx=\"128\" cy=\"120\" r=\"101\" stroke=\"#4473b7\" stroke-opacity=\".33\"/>\n          <circle cx=\"128\" cy=\"120\" r=\"113\" stroke=\"#729bdf\" stroke-opacity=\".25\" stroke-dasharray=\"1 5\"/>\n          <path d=\"M128 4v7m0 218v7M12 120h7m218 0h7\" stroke=\"#87b2f5\" stroke-opacity=\".55\"/>\n          <path d=\"M40.5 69.5a101 101 0 0 1 37-37m101 175a101 101 0 0 0 37-37\"\n                stroke=\"#5a8bd6\" stroke-opacity=\".62\" stroke-linecap=\"round\"/>\n        </g>\n\n        <g class=\"xsign-splash__ribbon xsign-splash__ribbon--up\">\n          <use href=\"#xsign-plate-up\" fill=\"url(#xsign-steel)\"/>\n          <path d=\"M196 54L94 186H60L92 181Z\" fill=\"#102e6c\" fill-opacity=\".35\"/>\n          <path d=\"M61 185L162.3 54.5H195\" stroke=\"#e1eeff\" stroke-opacity=\".65\" fill=\"none\"/>\n        </g>\n\n        <g class=\"xsign-splash__ribbon xsign-splash__ribbon--down\">\n          <g filter=\"url(#xsign-plate-shadow)\">\n            <use href=\"#xsign-plate-down\" fill=\"url(#xsign-ice)\"/>\n            <path d=\"M60 54L162 186H196L165 181Z\" fill=\"#46638c\" fill-opacity=\".30\"/>\n            <path d=\"M61 54.5H93.7L195 185\" stroke=\"#ffffff\" stroke-opacity=\".75\" fill=\"none\"/>\n          </g>\n        </g>\n\n        <g clip-path=\"url(#xsign-plate-clip)\">\n          <rect class=\"xsign-splash__reflection\" x=\"0\" y=\"32\" width=\"64\" height=\"176\" fill=\"url(#xsign-glint)\"/>\n        </g>\n      </svg>\n\n      <div class=\"xsign-splash__wordmark\">\n        <span class=\"xsign-splash__name\">XSign</span>\n        <span class=\"xsign-splash__edition\">IPA BLACK</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n",
